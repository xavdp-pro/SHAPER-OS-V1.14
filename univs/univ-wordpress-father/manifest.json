{
  "$schema": "../../schemas/universe-manifest.schema.json",
  "universe": "univ-wordpress-father",
  "description": "Father supervisor for univ-wordpress-child (Rule 23, 27, 36).",
  "routing": {
    "zone": "${WP_ZONE}",
    "managerSlug": "wpmanager01",
    "managerUrl": "https://${WP_MANAGER_HOST}",
    "managerLocalPort": 9470
  },
  "bricks": {
    "vault": { "port": 9410, "package": "@shaper/vault" },
    "logger": { "port": 9420, "package": "@shaper/logger" },
    "maestro": { "port": 9430, "package": "@shaper/maestro" },
    "queue": { "port": 9440, "package": "@shaper/queue" },
    "supervisor": { "port": 9460, "package": "@shaper/supervisor" },
    "manager-gateway": { "port": 9470, "package": "universe-local" }
  },
  "ports": {
    "vault": 9410,
    "logger": 9420,
    "maestro": 9430,
    "queue": 9440,
    "supervisor": 9460,
    "managerGateway": 9470
  },
  "alerting": {
    "channel": "logger",
    "note": "DEV only. Replace with an out-of-band human channel before TEST/PROD."
  },
  "dataLifecycle": {
    "personalData": false,
    "retention": { "logs": "30d", "vault": "unlimited" },
    "onTermination": "destroy sav/ and log/"
  }
}
