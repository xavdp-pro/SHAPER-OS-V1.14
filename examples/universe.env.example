# Optional universe overrides — copy to <univ_slug>-dev/deploy/env
# Secrets stay in software/.env (repo root → software/.env)
# Source before podman-up:  set -a && source deploy/env && set +a

UNIV_SLUG=myshop-dev

# tier-a is this repository's manifest (manifest.tier-a.json). Tier-b (public
# URL + voice) is the +web +public manifest from the SHAPER-OS-BRICKS
# catalogue, with the voice keys filled in software/.env — no switch here.

# PODMAN_NETWORK=host

# Override ports only if this host runs multiple stacks
# VAULT_PORT=8610
# LOGGER_PORT=8620
# OPENCODE_BRIDGE_PORT=4440
# QUEUE_PORT=8640
# MAESTRO_PORT=8630
# HELM_PORT=8650

# Cloudflare tunnel token file (never commit):
#   <univ_slug>-dev/sav/tunnel/token

# The database this universe declares (Rule 26: one MariaDB per universe).
# scripts/backup-local.sh and scripts/snapshot-universe.sh dump it when
# MYSQL_USER is set — MYSQL_PASSWORD is then required (it travels in
# MYSQL_PWD, never on a command line); MYSQL_DATABASE narrows the dump to one
# schema, unset means --all-databases; MYSQL_HOST / MYSQL_PORT are optional
# (127.0.0.1 / 3306). Without MYSQL_USER both scripts print SKIP and report
# "database":"skipped". Both scripts read the exported environment only and
# source nothing: run them from the shell that did `set -a && source
# deploy/env && set +a` (line 3), or from a cron entry exporting the same
# names. Never a value here: the real file is not committed.
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=
# MYSQL_HOST=
# MYSQL_PORT=
