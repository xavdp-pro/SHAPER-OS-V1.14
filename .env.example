# Same as software/.env.example — copy to software/.env from repo root:
#   cp .env.example software/.env

# SHAPER OS — never commit the real file
# Key URLs and tiers: KEYS-AND-ACCOUNTS.md
# Generate vault keys: openssl rand -hex 32  &&  openssl rand -hex 24

VAULT_MASTER_KEY=
VAULT_TOKEN=

DEEPGRAM_API_KEY=
GROQ_API_KEY=
GROQ_ACK_LLM=1
GROQ_ACK_MODEL=groq/compound-mini

# CARTESIA_API_KEY=
# ELEVENLABS_API_KEY=
# OPENROUTER_API_KEY=

OPENCODE_MODEL=opencode/nemotron-3.5-lightning-free
BRIDGE_OPENCODE_STUB=0

VAULT_PORT=8610
LOGGER_PORT=8620
OPENCODE_BRIDGE_PORT=4440
OPENCODE_SERVE_PORT=4441
QUEUE_PORT=8640
MAESTRO_PORT=8630
HELM_PORT=8650

APP_MODE=demo
JWT_SECRET=
MAIL_AGENT_STUB=1

