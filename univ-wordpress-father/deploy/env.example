# univ-wordpress-father — copy to deploy/env or source REMOTE3/.env
#
# DNS convention (test, no per-site customization):
#   Manager UI  →  {WP_MANAGER_SLUG}.{WP_ZONE}           = ${WP_MANAGER_HOST}
#   WordPress   →  {WP_SITE_SLUG}.{WP_MANAGER_SLUG}.{WP_ZONE} = ${WP_SITE_HOST}

WP_ZONE=${WP_ZONE}
WP_MANAGER_SLUG=wpmanager01
WP_SITE_SLUG=wp01
WP_MANAGER_PORT=9470
WP_CHILD_NAME=univ-wordpress-child

VAULT_MASTER_KEY=shaper-wp-father-master-key!!
VAULT_TOKEN=shaper-wp-father-token

# Single Cloudflare tunnel — configure two public hostnames in Zero Trust:
#   ${WP_MANAGER_HOST}      → http://127.0.0.1:9470
#   ${WP_SITE_HOST} → http://127.0.0.1:9580
CLOUDFLARE_WP_TUNNEL_TOKEN=
