# /etc/inputrc — Global Readline configuration for SHAPER OS & UNIV Containers.

# ------------------------------------------------------------------------------
# 1. Encoding & Meta Keys
# ------------------------------------------------------------------------------
set input-meta on
set output-meta on
set convert-meta off

# ------------------------------------------------------------------------------
# 2. Intelligent Autocompletion
# ------------------------------------------------------------------------------
set show-all-if-ambiguous on
set completion-ignore-case on
set mark-directories on
set mark-symlinked-directories on
set colored-stats on
set visible-stats on

# ------------------------------------------------------------------------------
# 3. Keybindings (Emacs Mode)
# ------------------------------------------------------------------------------
$if mode=emacs

# Home / End Keys
"\e[1~": beginning-of-line
"\e[4~": end-of-line
"\e[H": beginning-of-line
"\e[F": end-of-line

# Delete / Insert Keys
"\e[3~": delete-char
"\e[2~": quoted-insert

# History Search by Typed Prefix (Page Up / Page Down)
"\e[5~": history-search-backward
"\e[6~": history-search-forward

# History Search by Typed Prefix (Up / Down Arrows)
"\e[A": history-search-backward
"\e[B": history-search-forward

# Word Navigation (Ctrl+Left / Ctrl+Right)
"\e[1;5C": forward-word
"\e[1;5D": backward-word
"\e[5C": forward-word
"\e[5D": backward-word
"\e\e[C": forward-word
"\e\e[D": backward-word

$if term=rxvt
"\e[7~": beginning-of-line
"\e[8~": end-of-line
"\eOc": forward-word
"\eOd": backward-word
$endif

$endif
