# SHAPER OS — copy to software/.env (never commit the real file)
# Key URLs and tiers: ../docs/human/KEYS-AND-ACCOUNTS.md
# Generate vault keys with: openssl rand -hex 32  &&  openssl rand -hex 24

# --- Vault (agent generates) ---
VAULT_MASTER_KEY=
VAULT_TOKEN=

# --- Voice (human pastes — tier-b only: the catalogue's +web +public manifest) ---
DEEPGRAM_API_KEY=
GROQ_API_KEY=
# The voice acknowledgement engine — the same standard as every bridge model:
# measured at deploy, never written here (Rule 7). The value that shipped
# here was a vendor's model name, a default that ages with its catalogue.
# Nothing in this repository reads GROQ_ACK_LLM or GROQ_ACK_MODEL; the
# tier-b voice brick that does lives in the catalogue, outside this tree.
# GROQ_ACK_LLM=1 only switches that brick's acknowledgement on: with the
# model left empty it has nothing to acknowledge with, so the brick halts
# there, not here.
GROQ_ACK_LLM=1
GROQ_ACK_MODEL=

# --- Optional extra voice / routing (not required for tier-a) ---
# CARTESIA_API_KEY=
# ELEVENLABS_API_KEY=
# OPENROUTER_API_KEY=

# --- OpenCode bridge (model measured at deployment — see Rule 7) ---
# Measured at deployment: run `opencode models`, ping the candidates from the
# target host, and set the cheapest one that answers (Rule 7). Naming one here
# dates this file — the previous default was withdrawn while still shipped.
OPENCODE_MODEL=
BRIDGE_OPENCODE_STUB=0
# The other bridges, only when this universe enables them — same standard:
# measured at deploy, never written here. Each bridge halts without its
# variable; podman-up.sh halts before starting bridge-cursor or bridge-agy,
# and bridge-deepseek (which the template does not start) halts in its own
# process (Rule 7).
# CURSOR_MODEL=
# AGY_MODEL=
# ANTIGRAVITY_MODEL=
# OLLAMA_MODEL=
# DEEPSEEK_MODEL=

# --- Stack ports (one universe on one host — change if clash) ---
VAULT_PORT=8610
LOGGER_PORT=8620
OPENCODE_BRIDGE_PORT=4440
OPENCODE_SERVE_PORT=4441
QUEUE_PORT=8640
MAESTRO_PORT=8630
HELM_PORT=8650

# --- Runtime ---
APP_MODE=demo
JWT_SECRET=
MAIL_AGENT_STUB=1

# --- Optional cold backups (later) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com

# --- Database to dump (scripts/backup-local.sh, scripts/snapshot-universe.sh — Rule 12) ---
# MYSQL_USER declares that this universe has a database to dump; without it
# both scripts print SKIP and report "database":"skipped" — an honest skip,
# never an empty .sql passed off as a dump. MYSQL_PASSWORD is then required
# (it travels in MYSQL_PWD, never on a command line). MYSQL_DATABASE narrows
# the dump to one schema; unset, the dump is --all-databases. MYSQL_HOST and
# MYSQL_PORT are optional (the scripts fall back to 127.0.0.1 and 3306).
# A universe usually declares these in its own deploy/env (Rule 26: one
# MariaDB per universe) — see examples/universe.env.example. Both scripts
# read the exported environment only and source neither this file nor
# deploy/env: `set -a && source deploy/env && set +a` in the shell (or the
# cron entry) that runs them.
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=
# MYSQL_HOST=
# MYSQL_PORT=

# --- Off-site replication (scripts/backup-pra-sync.sh) ---
# PRA_ENCRYPTION_KEY is required, generated for backups only
# (openssl rand -hex 32), and refused when it equals VAULT_MASTER_KEY —
# in the environment or in any .env on disk. A backup encrypted with the
# vault's key hands the vault to whoever holds the backup file.
# PRA_DEST_HOST is optional: unset, the encrypted archive stays local.
# Both come from the exported environment — the script sources no .env file
# (it opens them only to refuse the vault key). Run it as:
#   env PRA_ENCRYPTION_KEY=<backup-only key> bash scripts/backup-pra-sync.sh
# PRA_ENCRYPTION_KEY=
# PRA_DEST_HOST=

# --- Private registry (scripts/push-images-to-registry.sh) ---
# All three are required and none has a default: a missing one halts the
# script, which names it. REGISTRY_HOST is host:port; SHAPER_REGISTRY (the
# registry contract's name) is accepted in its place. All three are read from
# the exported environment — the script sources no .env file; export them in
# the shell that runs it (the password typed with `read -rs`, never on a
# command line).
# REGISTRY_HOST=
# SHAPER_REGISTRY=
# REGISTRY_USER=
# REGISTRY_PASS=
