# SHAPER OS — copy to software/.env (never commit the real file)
# Key URLs and tiers: ../KEYS-AND-ACCOUNTS.md
# Generate vault keys with: openssl rand -hex 32  &&  openssl rand -hex 24

# --- Vault (agent generates) ---
VAULT_MASTER_KEY=
VAULT_TOKEN=

# --- Voice (human pastes — tier-b / WITH_HELM=1 only) ---
DEEPGRAM_API_KEY=
GROQ_API_KEY=
GROQ_ACK_LLM=1
GROQ_ACK_MODEL=groq/compound-mini

# --- Optional extra voice / routing (not required for tier-a) ---
# CARTESIA_API_KEY=
# ELEVENLABS_API_KEY=
# OPENROUTER_API_KEY=

# --- OpenCode bridge (e.g. opencode/nemotron-3.5-lightning-free, opencode/big-pickle, deepseek/deepseek-chat) ---
OPENCODE_MODEL=opencode/nemotron-3.5-lightning-free
BRIDGE_OPENCODE_STUB=0

# --- Stack ports (one universe on one host — change if clash) ---
VAULT_PORT=8610
LOGGER_PORT=8620
OPENCODE_BRIDGE_PORT=4440
OPENCODE_SERVE_PORT=4441
QUEUE_PORT=8640
MAESTRO_PORT=8630
HELM_PORT=8650

# --- Runtime ---
APP_MODE=demo
JWT_SECRET=
MAIL_AGENT_STUB=1

# --- Optional cold backups (later) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
