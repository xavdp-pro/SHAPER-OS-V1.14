# univ7 reference universe — optional overrides (main secrets in software/.env)
# Copy to deploy/univ7.env if needed

UNIVERSE=univ7
BRIDGE_AGY_STUB=1
MAIL_AGENT_STUB=1

VAULT_PORT=8710
LOGGER_PORT=8720
MAESTRO_PORT=8730
AGY_BRIDGE_PORT=8740

MAESTRO_TASKS_FILE=tasks/maestro-tasks.json
MAESTRO_BRIDGE_URL=http://127.0.0.1:8740
MAESTRO_AUTO_START=1

# Antigravity / Gemini — optional for live agy bridge (stub works without)
AGY_API_KEY=
GEMINI_API_KEY=
