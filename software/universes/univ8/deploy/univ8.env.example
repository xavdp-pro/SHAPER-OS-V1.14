# univ8 reference universe — optional overrides (main secrets in software/.env)
# Copy to deploy/univ8.env if you want universe-specific ports

UNIVERSE=univ8
WITH_HELM=0
MAIL_AGENT_STUB=1

VAULT_PORT=8610
LOGGER_PORT=8620
OPENCODE_BRIDGE_PORT=4440
OPENCODE_SERVE_PORT=4441
QUEUE_PORT=8640
MAESTRO_PORT=8630
HELM_PORT=8650

MAESTRO_TASKS_FILE=tasks/maestro-tasks.podman.json
MAESTRO_AUTO_START=1

