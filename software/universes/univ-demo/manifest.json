{
  "$schema": "../../schemas/universe-manifest.schema.json",
  "universe": "univ-demo",
  "description": "Public Shaper OS demo cockpit — restored daily at 02:00; modes Écran / Télécommande / Route",
  "intent": "./INTENT.md",
  "agentDeploy": "./AGENT-DEPLOY.md",

  "bricks": {
    "vault": {
      "ref": "../../bricks/brick-vault",
      "intent": "../../bricks/brick-vault/INTENT.md",
      "package": "@shaper/vault",
      "role": "Demo-only secrets (never production keys in this universe)"
    },
    "logger": {
      "ref": "../../bricks/brick-logger",
      "intent": "../../bricks/brick-logger/INTENT.md",
      "package": "@shaper/logger",
      "role": "Audit JSONL for demo beats"
    },
    "bridge-opencode": {
      "ref": "../../bricks/brick-bridge-opencode",
      "intent": "../../bricks/brick-bridge-opencode/INTENT.md",
      "package": "@shaper/bridge-opencode",
      "role": "AI CLI bridge for the public cockpit"
    },
    "queue": {
      "ref": "../../bricks/brick-queue",
      "intent": "../../bricks/brick-queue/INTENT.md",
      "package": "@shaper/queue",
      "role": "Async jobs → bridge"
    },
    "maestro": {
      "ref": "../../bricks/brick-maestro",
      "intent": "../../bricks/brick-maestro/INTENT.md",
      "package": "@shaper/maestro",
      "role": "Beat scheduler (demo cadence)",
      "specialize": {
        "how": "MAESTRO_TASKS_FILE → ./tasks/maestro-tasks.json",
        "file": "./tasks/maestro-tasks.json"
      }
    },
    "helm": {
      "ref": "../../bricks/brick-helm",
      "intent": "../../bricks/brick-helm/INTENT.md",
      "package": "helm-v2",
      "role": "Public operator cockpit — modes Écran, Télécommande, Route"
    }
  },

  "resources": {
    "maestroTasks": "./tasks/maestro-tasks.json",
    "agentContext": "./context/AGENT-CONTEXT.md",
    "nightlyRestore": "./scripts/nightly-restore.sh"
  },

  "bootOrder": [
    ["vault", "logger"],
    ["bridge-opencode"],
    ["queue"],
    ["maestro"],
    ["helm"]
  ],

  "ops": {
    "nightlyRestore": {
      "hourLocal": 2,
      "minute": 0,
      "purpose": "Reset playground DB + clear volatile tmp so visitors cannot leave lasting damage"
    }
  }
}
