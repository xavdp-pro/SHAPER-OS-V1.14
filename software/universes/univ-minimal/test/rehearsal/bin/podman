#!/usr/bin/env node
// Intent: software/universes/univ-minimal/INTENT.md#rehearsal
// Rehearsal-only podman — never on a real host's PATH: no container, no namespace. Each "unit container" is
// the unit's real server.js, run as a process with the container's paths
// redirected (redirect.mjs) and its database on the one throwaway MariaDB of
// the rehearsal. It proves the deploy scripts' order, wiring and identity
// path against the real services — never the Rule 26 container inventory.
//
//   FAKE_STATE   directory for container state and logs
//   FAKE_SOCKET  the throwaway MariaDB socket
//   FAKE_SOFTWARE  the worktree's software/ directory
//   FAKE_MARIADB the MariaDB client binary
import fs from 'node:fs';
import http from 'node:http';
import path from 'node:path';
import { spawn, spawnSync } from 'node:child_process';
import { fileURLToPath } from 'node:url';

const __dirname = path.dirname(fileURLToPath(import.meta.url));

const STATE = process.env.FAKE_STATE;
const SOCKET = process.env.FAKE_SOCKET;
const SOFTWARE = process.env.FAKE_SOFTWARE;
const MARIADB = process.env.FAKE_MARIADB;
const REDIRECT = path.join(__dirname, '..', 'redirect.mjs');
const argv = process.argv.slice(2);
const die = (msg, code = 125) => { process.stderr.write(`fake-podman: ${msg}\n`); process.exit(code); };
const stateFile = (name) => path.join(STATE, `${name}.json`);
const readState = (name) => { try { return JSON.parse(fs.readFileSync(stateFile(name), 'utf8')); } catch { return null; } };
const alive = (pid) => { try { process.kill(pid, 0); return true; } catch { return false; } };
const slugOfImage = (image) => (/brick-([a-z]+):/.exec(image) || [])[1];
fs.mkdirSync(STATE, { recursive: true });
fs.appendFileSync(path.join(STATE, 'argv.log'), `${JSON.stringify(argv)}\n`);

function parseRun(args) {
  const o = { env: {}, mounts: [], rm: false, detach: false, name: null, entrypoint: null, replace: false };
  let i = 0;
  const withValue = new Set(['--name', '--network', '--restart', '--stop-timeout', '--cap-add', '--security-opt', '--health-cmd', '--health-interval', '--health-retries', '--health-start-period', '--user', '--entrypoint']);
  for (; i < args.length; i++) {
    const a = args[i];
    if (a === '--rm') o.rm = true;
    else if (a === '-d') o.detach = true;
    else if (a === '--replace') o.replace = true;
    else if (a === '-e') { const kv = args[++i]; const eq = kv.indexOf('='); if (eq < 0) { if (process.env[kv] !== undefined) o.env[kv] = process.env[kv]; } else o.env[kv.slice(0, eq)] = kv.slice(eq + 1); }
    else if (a === '-v') { const [src, dst] = args[++i].split(':'); o.mounts.push([dst, src]); }
    else if (a.startsWith('--cap-drop') || a.startsWith('--security-opt=') || a.startsWith('--cap-add=') || a.startsWith('--health-')) { /* hardening is the container's; nothing to emulate */ }
    else if (withValue.has(a)) { const v = args[++i]; if (a === '--name') o.name = v; if (a === '--entrypoint') o.entrypoint = v; }
    else if (/^--[a-z-]+=/.test(a)) { /* --restart=always and the like: the container's, nothing to emulate */ }
    else if (a.startsWith('-')) die(`run option ${a} not emulated`);
    else break;
  }
  o.image = args[i];
  o.cmd = args.slice(i + 1);
  return o;
}

function stop(name) {
  const st = readState(name);
  if (!st || !alive(st.pid)) return;
  try { process.kill(-st.pid, 'SIGTERM'); } catch { try { process.kill(st.pid, 'SIGTERM'); } catch {} }
  const until = Date.now() + 40000;
  while (alive(st.pid) && Date.now() < until) spawnSync('sleep', ['0.2']);
  if (alive(st.pid)) { try { process.kill(-st.pid, 'SIGKILL'); } catch {} }
}

function startService(o) {
  const slug = slugOfImage(o.image) || die(`image ${o.image} names no unit`);
  const env = {
    PATH: process.env.PATH, NODE_ENV: 'production', SHAPER_UNIT_SLUG: slug, SHAPER_DB_SOCKET: SOCKET,
    [`${slug.toUpperCase()}_STORE`]: 'mariadb', ...(slug === 'maestro' ? { MAESTRO_AUTO_START: '0' } : {}),
    ...o.env,
  };
  // The supervisor keeps its own controls; the application gets the rest.
  for (const k of ['UNIT_MODE', 'UNIT_HEALTH_URL', 'UNIT_RESTORE_DUMP']) delete env[k];
  env.FAKE_MOUNTS = JSON.stringify(o.mounts);
  const log = fs.openSync(path.join(STATE, `${o.name}.log`), 'a');
  const child = spawn(process.execPath, ['--import', REDIRECT, path.join(SOFTWARE, 'packages', `pkg-${slug}`, 'server.js')], {
    cwd: path.join(SOFTWARE, 'packages', `pkg-${slug}`), env, detached: true, stdio: ['ignore', log, log],
  });
  child.unref();
  fs.writeFileSync(stateFile(o.name), JSON.stringify({ name: o.name, pid: child.pid, slug, image: o.image, env: { ...o.env }, health: o.env.UNIT_HEALTH_URL, spec: o, started: Date.now() }));
}

function health(url) {
  return new Promise((resolve) => {
    const req = http.get(url, { timeout: 3000 }, (res) => { res.resume(); resolve(res.statusCode); });
    req.on('error', () => resolve(0));
    req.on('timeout', () => { req.destroy(); resolve(0); });
  });
}

async function main() {
  const [cmd, ...rest] = argv;
  switch (cmd) {
    case 'pull': process.exit(1);
    case 'image': {
      const [sub, ...r] = rest;
      if (sub === 'exists') process.exit(slugOfImage(r.at(-1)) ? 0 : 1);
      if (sub === 'inspect') {
        const slug = slugOfImage(r.at(-1));
        const { unit } = JSON.parse(fs.readFileSync(path.join(SOFTWARE, 'bricks', `brick-${slug}`, 'brick.json'), 'utf8'));
        process.stdout.write(`${unit.slug}:${unit.uid}:${unit.engineUid}:${unit.schemaVersion}\n`);
        process.exit(0);
      }
      die(`image ${sub}`);
    }
    case 'container': if (rest[0] === 'exists') process.exit(readState(rest[1]) && alive(readState(rest[1]).pid) ? 0 : 1); die('container');
    case 'ps': {
      for (const f of fs.readdirSync(STATE).filter((x) => x.endsWith('.json'))) { const st = readState(f.slice(0, -5)); if (st && alive(st.pid)) process.stdout.write(`${st.name}\n`); }
      process.exit(0);
    }
    case 'run': {
      const o = parseRun(rest);
      if (o.detach) {
        if (o.replace) stop(o.name);
        startService(o);
        process.stdout.write(`${o.name}\n`);
        process.exit(0);
      }
      if (o.rm && o.entrypoint === 'node') {
        const [script, ...args] = o.cmd;
        const host = script.replace(/^\/apps\/[a-z]+\/app\/packages\//, `${SOFTWARE}/packages/`);
        const env = { PATH: process.env.PATH, ...o.env, FAKE_MOUNTS: JSON.stringify(o.mounts) };
        const r = spawnSync(process.execPath, ['--import', REDIRECT, host, ...args], { env, stdio: 'inherit' });
        process.exit(r.status ?? 1);
      }
      die('run mode not emulated');
    }
    case 'exec': {
      let i = 0; let stdin = false;
      for (; i < rest.length && rest[i].startsWith('-'); i++) { if (rest[i] === '-i') stdin = true; else if (rest[i] === '--user') i++; }
      const name = rest[i]; const [prog, ...args] = rest.slice(i + 1);
      const st = readState(name);
      if (!st || !alive(st.pid)) die(`${name} is not running`, 1);
      if (prog === 'unit-ready') {
        const code = await health(st.health);
        process.stdout.write(code >= 200 && code < 300 ? `ready: ${st.slug} (rehearsal process ${st.pid})\n` : `not ready: health ${code}\n`);
        process.exit(code >= 200 && code < 300 ? 0 : 1);
      }
      if (prog === 'mariadb' || prog === 'mariadb-dump') {
        const mapped = args.map((a, k) => (args[k - 1] === '-S' ? SOCKET : a.startsWith('--socket=') ? `--socket=${SOCKET}` : a));
        const bin = prog === 'mariadb' ? MARIADB : MARIADB.replace(/mariadb$/, 'mariadb-dump');
        const r = spawnSync(bin, mapped, { stdio: [stdin ? 'inherit' : 'ignore', 'inherit', 'inherit'] });
        process.exit(r.status ?? 1);
      }
      die(`exec ${prog} not emulated`);
    }
    case 'inspect': {
      const f = rest[rest.indexOf('-f') + 1]; const name = rest.at(-1); const st = readState(name);
      if (!st) process.exit(125);
      if (f === '{{.State.Status}}') process.stdout.write(`${alive(st.pid) ? 'running' : 'exited'}\n`);
      else if (f === '{{.State.Running}}') process.stdout.write(`${alive(st.pid)}\n`);
      else if (f === '{{.Id}}') process.stdout.write(`${st.name}-${st.pid}\n`);
      else if (f === '{{.Image}}') process.stdout.write(`${st.image}\n`);
      else if (f === '{{range .Config.Env}}{{println .}}{{end}}') process.stdout.write(Object.entries(st.env).map(([k, v]) => `${k}=${v}\n`).join(''));
      else die(`inspect format ${f}`);
      process.exit(0);
    }
    case 'logs': {
      const name = rest.at(-1);
      try { process.stdout.write(fs.readFileSync(path.join(STATE, `${name}.log`), 'utf8')); } catch {}
      process.exit(0);
    }
    case 'restart': { const st = readState(rest.at(-1)); stop(st.name); startService(st.spec); process.exit(0); }
    case 'stop': stop(rest.at(-1)); process.exit(0);
    case 'rm': stop(rest.at(-1)); try { fs.rmSync(stateFile(rest.at(-1))); } catch {} process.exit(0);
    default: die(`${cmd} not emulated`);
  }
}
main();
