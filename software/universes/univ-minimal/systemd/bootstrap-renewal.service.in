# Intent: software/universes/univ-minimal/INTENT.md#renewal
# Rendered by deploy/install-renewal-timer.sh. The parent's daily selective
# bootstrap renewal (SOL decision L): one run of deploy/renew-bootstraps.sh.
# Every consistent identity due within 7 days is renewed; a missing, expired,
# revoked or inconsistent one is left unchanged and the run exits 2 (partial);
# an unverifiable universe, input or authority exits 1 (halted); a lost
# acknowledgement exits 3. Any of them fails this unit: the universe's watcher
# reports the failed unit on its declared human channel (OnFailure= starts it
# at once when declared), whether or not Vault's relay reaches Logger.
[Unit]
Description=SHAPER @UNIVERSE@: renew unit bootstraps before they expire
After=podman-restart.service
@ALERT_LINE@

[Service]
Type=oneshot
@ENV_LINE@
ExecStart=/usr/bin/env bash @UNIV@/deploy/renew-bootstraps.sh
