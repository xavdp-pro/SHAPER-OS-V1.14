# Copy to cfg-univ-minimal.env inside the universe container. Do not commit it.
# Every value below is an instance parameter (Rule 0B); nothing here is a
# secret, and no secret has a default.

# The instance slug: container and volume names are prefixed with it.
SHAPER_UNIVERSE=univ-minimal

# Where each unit's Turbinobash layout lives inside the universe container:
# <root>/<slug>/etc/mysql, <root>/<slug>/sav and <root>/<slug>/log are the
# unit's three volumes.
SHAPER_APPS_ROOT=/apps

# The machine's registry and the tag the bricks were published under
# (scripts/build-*.sh), or leave empty and pin cfg-image-lock.json instead.
# DEV only: SHAPER_REGISTRY=localhost names images built on this machine with
# SHAPER_PUSH=0. Each unit image carries its own MariaDB server.
SHAPER_REGISTRY=
SHAPER_IMAGE_TAG=

# The universe identity, a lowercase UUID: Vault's signing domain and part of
# every Maestro occurrence id. Leave it empty: deploy/podman-up.sh generates it
# once, beside the Vault master key (<root>/vault/etc/vault/universe-id), and
# refuses a value that differs from the one recorded. Name it here only to
# re-create a universe whose identity is known; it is not a secret.
SHAPER_UNIVERSE_ID=

# Where the proof keeps its state and its own reader identity (root-only).
# PROOF_STATE_DIR=/var/lib/univ-proof/univ-minimal

# The parent's secrets store (INTENT.md#secret-files): root-only, one
# directory per unit, each secret a root 0600 file the unit receives as its own
# read-only copy, named by <NAME>_FILE. No secret value ever goes in this file:
# podman-up.sh refuses a secret-shaped variable (VAULT_TOKEN=…, *_PASSWORD=…)
# that carries one.
# SHAPER_SECRETS_ROOT=/apps/.state/secrets
