{
  "$schema": "../../schemas/universe-manifest.schema.json",
  "universe": "univX",
  "description": "Template — copy to universes/<slug>/manifest.json",
  "intent": "./INTENT.md",
  "agentDeploy": "./AGENT-DEPLOY.md",

  "bricks": {
    "vault": {
      "ref": "../../bricks/brick-vault",
      "intent": "../../bricks/brick-vault/INTENT.md",
      "package": "@shaper/pkg-vault",
      "role": "<WHY this brick in this universe>",
      "specialize": {
        "how": "Bootstrap from resources/vault-resources.local.json",
        "file": "../../resources/vault-resources.local.json",
        "bootstrap": "npm run vault:bootstrap"
      }
    },
    "logger": {
      "ref": "../../bricks/brick-logger",
      "intent": "../../bricks/brick-logger/INTENT.md",
      "package": "@shaper/pkg-logger",
      "role": "Audit JSONL",
      "specialize": { "how": "Use generic brick as-is" }
    },
    "bridge-opencode": {
      "ref": "../../bricks/brick-bridge-opencode",
      "intent": "../../bricks/brick-bridge-opencode/INTENT.md",
      "package": "@shaper/pkg-bridge-opencode",
      "role": "Free OpenCode AI bridge",
      "specialize": { "how": "Default model opencode/nemotron-3.5-lightning-free" }
    },
    "queue": {
      "ref": "../../bricks/brick-queue",
      "intent": "../../bricks/brick-queue/INTENT.md",
      "package": "@shaper/pkg-queue",
      "role": "Async jobs → bridge"
    },
    "maestro": {
      "ref": "../../bricks/brick-maestro",
      "intent": "../../bricks/brick-maestro/INTENT.md",
      "package": "@shaper/pkg-maestro",
      "role": "Beat scheduler",
      "specialize": {
        "how": "MAESTRO_TASKS_FILE → ./tasks/task-schedule.json",
        "file": "./tasks/task-schedule.json"
      }
    }
  },

  "resources": {
    "vaultBootstrap": "../../resources/vault-resources.local.json",
    "maestroTasks": "./tasks/task-schedule.json",
    "agentContext": "./context/ctx-universe.md"
  },

  "bootOrder": [
    ["vault", "logger"],
    ["bridge-opencode"],
    ["queue"],
    ["maestro"]
  ]
}
