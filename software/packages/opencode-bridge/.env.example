# opencode-bridge — copy to .env (chmod 600) and adjust.
OPENCODE_BRIDGE_PORT=4340
OPENCODE_BRIDGE_BIND=127.0.0.1
OPENCODE_BIN=/opt/bridge/opencode/bin/opencode
OPENCODE_WS_BASE=/apps/helm-v2/ws/opencode
# Internal port of the headless `opencode serve` child (not exposed).
OPENCODE_SERVE_PORT=4341
# provider/model — see `opencode models`. The *-free models cost nothing.
OPENCODE_MODEL=opencode/nemotron-3.5-lightning-free
