# opencode-bridge — copy to .env (chmod 600) and adjust.
OPENCODE_BRIDGE_PORT=4440
OPENCODE_BRIDGE_BIND=127.0.0.1
# Unset, server.mjs looks for the CLI under /opt/bridge/opencode/bin/opencode
# (OPT_BRIDGE_ROOT) and keeps workspaces under $HOME/ws/opencode. Name your
# own paths here; the example ships nobody's host layout (Boot Contract 10b).
OPENCODE_BIN=
OPENCODE_WS_BASE=
# Internal port of the headless `opencode serve` child (not exposed).
OPENCODE_SERVE_PORT=4441
# provider/model — see `opencode models`. The *-free models cost nothing.
# Measured at deployment (`opencode models` + a ping from the target host), never named here — Rule 7.
OPENCODE_MODEL=
