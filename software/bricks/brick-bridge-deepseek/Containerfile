ARG SHAPER_BASE_IMAGE
FROM ${SHAPER_BASE_IMAGE} AS shaper_base
FROM docker.io/library/node:20-alpine

ARG SHAPER_SOURCE_REVISION
LABEL org.opencontainers.image.revision="${SHAPER_SOURCE_REVISION}"
LABEL org.shaper.brick="bridge-deepseek"
LABEL org.shaper.build-packages="logger bridge-deepseek"

WORKDIR /app
COPY --from=shaper_base /shaper/packages/pkg-logger/ /pkg-logger/
COPY --from=shaper_base /shaper/packages/pkg-bridge-deepseek/ ./

EXPOSE 4350
ENV NODE_ENV=production
ENV HOME=/root
ENV DEEPSEEK_BRIDGE_PORT=4350
ENV DEEPSEEK_BRIDGE_BIND=0.0.0.0
ENV DEEPSEEK_WS_BASE=/data/deepseek-ws
# No model is baked in: it is measured from the target host at deployment and
# supplied here (Rule 7) — the same shape as the cursor and opencode bricks.
ENV OLLAMA_MODEL=
ENV DEEPSEEK_MODEL=

CMD ["node", "server.js"]
