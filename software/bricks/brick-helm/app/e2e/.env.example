# Copier vers e2e/.env (gitignored) pour les tests Playwright locaux.
PLAYWRIGHT_BASE_URL=http://127.0.0.1:7923
HELM_E2E_EMAIL=xavier@xavdp.pro
HELM_E2E_USER_ID=3
HELM_E2E_ROLE=admin

# Auth E2E préférée : JWT (bypass login) — même valeur que JWT_SECRET du serveur
HELM_E2E_JWT_SECRET=

# Fallback : login UI (si pas de JWT)
HELM_E2E_PASSWORD=

# Tests agent Cursor (lents, consomment des tokens) — npm run test:e2e:agent
HELM_E2E_AGENT=0
HELM_E2E_AGENT_TIMEOUT_MS=240000
HELM_E2E_AGENT_CONVERSATION=gbs-h1/zaza/Interface
