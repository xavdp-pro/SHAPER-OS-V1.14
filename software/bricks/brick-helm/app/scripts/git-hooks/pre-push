#!/usr/bin/env bash
# Garde-fou : le chat doit être "carré" avant tout push sur helm-v2.
# Contourner ponctuellement : git push --no-verify
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

echo "🔎 pre-push : vérification du chat (npm run test:chat)…"
if npm run test:chat; then
  echo "✅ Chat carré — push autorisé."
  exit 0
fi
echo "❌ Tests chat en échec — push bloqué. (git push --no-verify pour forcer)"
exit 1
