# Étape 1 : Build du frontend Vite
FROM docker.io/library/node:20-alpine AS builder
WORKDIR /app
COPY bricks/brick-helm/app/package*.json ./
RUN npm install
COPY bricks/brick-helm/app/ ./
RUN npm run build

# Étape 2 : Image d'exécution Shaper-Helm avec MariaDB embarqué
FROM docker.io/library/node:20-alpine
RUN apk add --no-cache mariadb mariadb-client bash
WORKDIR /app

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/server ./server
COPY --from=builder /app/src ./src
COPY --from=builder /app/public ./public
COPY --from=builder /app/index.html ./index.html
COPY --from=builder /app/vite.config.js ./vite.config.js
COPY --from=builder /app/package.json ./package.json
COPY bricks/brick-helm/init.sql /app/init.sql
COPY bricks/brick-helm/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

EXPOSE 8650
ENV NODE_ENV=production
ENV PORT=8650
ENV MYSQL_HOST=127.0.0.1
ENV MYSQL_PORT=3306
ENV MYSQL_USER=helm_user
ENV MYSQL_PASSWORD=helm_password_local
ENV MYSQL_DATABASE=helm_db
ENV HELM_DATA_DIR=/data

ENTRYPOINT ["/app/entrypoint.sh"]
