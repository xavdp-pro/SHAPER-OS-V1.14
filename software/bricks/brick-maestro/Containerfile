FROM docker.io/library/node:20-alpine

WORKDIR /app
COPY packages/pkg-logger/ ./packages/pkg-logger/
COPY packages/pkg-auth/ ./packages/pkg-auth/
COPY packages/pkg-agent-runtime/ ./packages/pkg-agent-runtime/
COPY packages/pkg-vault/ ./packages/pkg-vault/
COPY packages/pkg-maestro/ ./packages/pkg-maestro/

WORKDIR /app/packages/pkg-maestro

EXPOSE 8530
ENV NODE_ENV=production
ENV MAESTRO_PORT=8530
ENV MAESTRO_AUTO_START=0

CMD ["node", "server.js"]
