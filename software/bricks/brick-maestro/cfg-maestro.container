[Unit]
Description=SHAPER OS Maestro with its own MariaDB (Podman Quadlet)
After=network-online.target

# The image is written by the universe that installs this unit, from the digest
# recorded in its cfg-image-lock.json. A tag can be moved under a running system;
# a digest cannot, and `latest` is forbidden outright — which is exactly what
# this line used to say before V1.11.
#
#   sed -e "s|@IMG@|$(digest from cfg-image-lock.json)|" -e "s|%i|<universe>|g" \
#       -e "s|@UNIVERSE_ID@|<universe UUID>|" -e "s|@INCARNATION@|<registered incarnation>|"
#
# ContainerName follows docs/architecture/NAMING.md: ctr- is a running
# container role, prefixed by the universe so two universes on one host never
# collide.
#
# One container, two processes (Rule 4, Turbinobash method;
# software/runtime/unit-mariadb/INTENT.md): the image's supervisor starts the
# unit's own MariaDB as mysql, socket only, then the application as maestro
# (10630). There is no database container beside this one and no User= line:
# the supervisor is the container's administrative path and drops to each
# account itself. The two volumes are the unit's persistent state — its
# password, its datadir and dumps — owned file by file, never chowned
# recursively. Maestro has no log volume: its evidence is an outbox row in its
# own database until Logger receipts it, and it writes no local file.
#
# Identity (pkg-auth, pkg-vault INTENT#parent-registration): the parent pins
# Vault's signing public key and registers this unit's incarnation, then
# delivers etc/identity/ — the pin (root, 0644) and, for a unit that holds a
# credential, its bootstrap (the unit's account, 0600) — mounted read-only.
# univ-minimal's deploy/podman-up.sh does exactly that, in the birth order.
[Container]
Image=@IMG@
ContainerName=%i-ctr-maestro
Network=host
Environment=MAESTRO_PORT=8630
Environment=HOST=127.0.0.1
Environment=MAESTRO_AUTO_START=1
Environment=UNIT_HEALTH_URL=http://127.0.0.1:8630/api/health
# The universe identity (a UUID, also Vault's signing domain) is part of every
# occurrence id; the queue is the only place an occurrence goes (there is no
# direct bridge path in this store).
Environment=SHAPER_UNIVERSE_ID=@UNIVERSE_ID@
Environment=SHAPER_UNIT_INCARNATION=@INCARNATION@
Environment=MAESTRO_QUEUE_URL=http://127.0.0.1:8640
Environment=LOGGER_URL=http://127.0.0.1:8620
Environment=VAULT_URL=http://127.0.0.1:8610
Environment=UNIT_AUTH_PUBLIC_KEY_FILE=/apps/maestro/etc/identity/vault-signing.pub
Environment=UNIT_BOOTSTRAP_TOKEN_FILE=/apps/maestro/etc/identity/bootstrap
# The installing universe adds its declared schedule, read-only, e.g.
#   Volume=<universe dir>/task-schedule.json:/apps/maestro/etc/task-schedule.json:ro,Z
#   Environment=MAESTRO_TASKS_FILE=/apps/maestro/etc/task-schedule.json
# Without one, Maestro stays idle and creates no work.
Volume=/apps/maestro/etc/mysql:/apps/maestro/etc/mysql:Z
Volume=/apps/maestro/sav:/apps/maestro/sav:Z
Volume=/apps/maestro/etc/identity:/apps/maestro/etc/identity:ro,Z
DropCapability=all
AddCapability=CHOWN DAC_OVERRIDE FOWNER KILL SETGID SETUID
NoNewPrivileges=true
HealthCmd=/usr/local/bin/unit-ready
HealthInterval=15s
HealthStartPeriod=180s
HealthRetries=3
# The application drains (UNIT_DRAIN_SECONDS, 20) before MariaDB shuts down
# (UNIT_ENGINE_STOP_SECONDS, 60): the stop timeout covers both.
StopTimeout=90

[Service]
Restart=always
TimeoutStopSec=100

[Install]
WantedBy=multi-user.target
