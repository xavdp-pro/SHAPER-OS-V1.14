[Unit]
Description=SHAPER OS Queue (Podman Quadlet)
After=network-online.target

# The image is written by the universe that installs this unit, from the digest
# recorded in its cfg-image-lock.json. A tag can be moved under a running system;
# a digest cannot, and `latest` is forbidden outright — which is exactly what
# this line used to say before V1.11.
#
#   sed -e "s|@IMG@|$(digest from cfg-image-lock.json)|" -e "s|%i|<universe>|g"
#
# ContainerName and Volume follow docs/architecture/NAMING.md: ctr- is a running
# container role, vol- a persistent universe-owned volume, and both are prefixed
# by the universe so two universes on one host never collide.
[Container]
Image=@IMG@
ContainerName=%i-ctr-queue
Network=host
Environment=QUEUE_PORT=8640
Environment=HOST=127.0.0.1
# The unit's private MariaDB (Rules 4 and 26) runs beside it as
# %i-ctr-queue-mariadb, provisioned by scripts/provision-unit-mariadb.sh; the
# socket directory and the passwd file are the only paths the two share. Jobs
# live there, so this unit mounts no volume of its own.
Volume=/apps/queue/nosav/run/mysqld:/run/mysqld:z
Volume=/apps/queue/etc/mysql/localhost/passwd:/apps/queue/etc/mysql/localhost/passwd:ro,Z
User=10640:10640
Restart=always

[Install]
WantedBy=multi-user.target
