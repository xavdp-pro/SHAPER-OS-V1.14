ARG SHAPER_BASE_IMAGE
ARG NODE_IMAGE=docker.io/library/node:20-alpine
FROM ${SHAPER_BASE_IMAGE} AS shaper_base
FROM ${NODE_IMAGE}

# One functional unit, Turbinobash method (Rule 4; runtime/unit-mariadb/INTENT.md):
# the queue application and its own MariaDB server, two processes in this one
# container. `queue` is the Linux account, the MariaDB account and the database.
ARG SHAPER_SOURCE_REVISION
ARG NODE_IMAGE
ARG SHAPER_BASE_IMAGE
LABEL org.opencontainers.image.revision="${SHAPER_SOURCE_REVISION}"
LABEL org.shaper.node-image="${NODE_IMAGE}"
LABEL org.shaper.base-image="${SHAPER_BASE_IMAGE}"
LABEL org.shaper.brick="queue"
LABEL org.shaper.build-packages="auth db logger queue"
LABEL org.shaper.unit.slug="queue"
LABEL org.shaper.unit.uid="10640"
LABEL org.shaper.unit.engine-uid="10641"
LABEL org.shaper.unit.database="mariadb-in-unit"
LABEL org.shaper.unit.schema="/apps/queue/app/packages/pkg-queue/sql/schema.sql"
LABEL org.shaper.unit.schema-version="3"

# The engine account is created first, with its fixed uid, so the MariaDB
# package's install script keeps it instead of picking whatever uid is free: a
# datadir must belong to the same uid in every rebuild of this image.
ARG UNIT_UID=10640
ARG ENGINE_UID=10641
RUN addgroup -S -g "${ENGINE_UID}" mysql \
 && adduser -S -D -H -h /var/lib/mysql -s /sbin/nologin -u "${ENGINE_UID}" -G mysql mysql \
 && addgroup -S -g "${UNIT_UID}" queue \
 && adduser -S -D -H -h /apps/queue -s /sbin/nologin -u "${UNIT_UID}" -G queue queue \
 && apk add --no-cache mariadb mariadb-client tini \
 && test "$(id -u mysql):$(id -g mysql)" = "${ENGINE_UID}:${ENGINE_UID}" \
 && test "$(id -u queue):$(id -g queue)" = "${UNIT_UID}:${UNIT_UID}" \
 && printf '[client]\nsocket=/run/queue/mysqld.sock\n' > /etc/my.cnf.d/zz-shaper-unit.cnf \
 && chmod 0644 /etc/my.cnf.d/zz-shaper-unit.cnf

# The application code, owned by root and read-only to the unit account
# (Rule 4: app/). Every package sits beside the others, so `../pkg-*/` resolves.
COPY --from=shaper_base /shaper/packages/pkg-db/ /apps/queue/app/packages/pkg-db/
RUN cd /apps/queue/app/packages/pkg-db && npm ci --omit=dev --ignore-scripts --no-audit --no-fund && npm cache clean --force
COPY --from=shaper_base /shaper/packages/pkg-auth/ /apps/queue/app/packages/pkg-auth/
COPY --from=shaper_base /shaper/packages/pkg-logger/ /apps/queue/app/packages/pkg-logger/
COPY --from=shaper_base /shaper/packages/pkg-queue/ /apps/queue/app/packages/pkg-queue/

# The unit's MariaDB lifecycle: the container's administrative path, run as root.
COPY --from=shaper_base /shaper/runtime/unit-mariadb/ /usr/local/lib/shaper/unit-mariadb/
RUN ln -s /usr/local/lib/shaper/unit-mariadb/unit-ready /usr/local/bin/unit-ready \
 && install -d -m 0755 -o root -g root /apps/queue/etc /apps/queue/etc/mysql /apps/queue/sav \
 && install -d -m 0750 -o root -g queue /apps/queue/etc/mysql/localhost \
 && install -d -m 0750 -o queue -g queue /apps/queue/log /apps/queue/nosav

ENV NODE_ENV=production \
    SHAPER_UNIT_SLUG=queue \
    SHAPER_DB_SOCKET=/run/queue/mysqld.sock \
    UNIT_UID=10640 \
    UNIT_ENGINE_UID=10641 \
    UNIT_SCHEMA_FILE=/apps/queue/app/packages/pkg-queue/sql/schema.sql \
    UNIT_SCHEMA_VERSION=3 \
    QUEUE_PORT=8640 \
    QUEUE_STORE=mariadb

# The image refuses to exist when it would refuse to start.
RUN UNIT_IMPORT_CHECK="/apps/queue/app/packages/pkg-queue/index.js /apps/queue/app/packages/pkg-queue/mariadb-store.js /apps/queue/app/packages/pkg-auth/runtime-identity.js /apps/queue/app/packages/pkg-db/outbox.js" node /usr/local/lib/shaper/unit-mariadb/image-check.mjs

WORKDIR /apps/queue/app/packages/pkg-queue
EXPOSE 8640
# No USER: the supervisor is root, starts mariadbd as mysql and the application
# as queue (10640); the application itself never runs as root.
ENTRYPOINT ["/sbin/tini", "--", "node", "/usr/local/lib/shaper/unit-mariadb/supervisor.mjs"]
CMD ["node", "server.js"]
