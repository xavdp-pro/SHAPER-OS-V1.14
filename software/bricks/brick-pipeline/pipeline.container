[Unit]
Description=Shaper OS — Document Understanding Pipeline (OCR, Geometry, Legibility)
After=network-online.target

[Container]
Image=localhost/shaper-pipeline:latest
ContainerName=shaper-pipeline
Network=host
Environment=PIPELINE_PORT=8670
Environment=NODE_ENV=production

[Service]
Restart=always

[Install]
WantedBy=default.target
