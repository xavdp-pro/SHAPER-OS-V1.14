FROM docker.io/library/node:20-alpine

WORKDIR /app

# ged-engine importe l'extracteur de texte de @shaper/rag (analyse par fichier).
# La disposition relative packages/<nom> doit être préservée dans l'image.
COPY packages/ged-engine/ ./packages/ged-engine/
COPY packages/rag/ ./packages/rag/

WORKDIR /app/packages/ged-engine

EXPOSE 8660
ENV NODE_ENV=production
ENV GED_PORT=8660
ENV GED_DATA_DIR=/data/ged

CMD ["node", "server.js"]
