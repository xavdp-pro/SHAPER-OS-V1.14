ARG SHAPER_BASE_IMAGE
ARG NODE_IMAGE=docker.io/library/node:20-alpine
FROM ${SHAPER_BASE_IMAGE} AS shaper_base
FROM ${NODE_IMAGE}

# One functional unit, Turbinobash method (Rule 4; runtime/unit-mariadb/INTENT.md):
# the logger application and its own MariaDB server, two processes in this one
# container. `logger` is the Linux account, the MariaDB account and the database.
ARG SHAPER_SOURCE_REVISION
ARG NODE_IMAGE
ARG SHAPER_BASE_IMAGE
LABEL org.opencontainers.image.revision="${SHAPER_SOURCE_REVISION}"
LABEL org.shaper.node-image="${NODE_IMAGE}"
LABEL org.shaper.base-image="${SHAPER_BASE_IMAGE}"
LABEL org.shaper.brick="logger"
LABEL org.shaper.build-packages="db logger"
LABEL org.shaper.unit.slug="logger"
LABEL org.shaper.unit.uid="10620"
LABEL org.shaper.unit.engine-uid="10621"
LABEL org.shaper.unit.database="mariadb-in-unit"
LABEL org.shaper.unit.schema="/apps/logger/app/packages/pkg-logger/sql/schema.sql"
LABEL org.shaper.unit.schema-version="1"

# The engine account is created first, with its fixed uid, so the MariaDB
# package's install script keeps it instead of picking whatever uid is free: a
# datadir must belong to the same uid in every rebuild of this image.
ARG UNIT_UID=10620
ARG ENGINE_UID=10621
RUN addgroup -S -g "${ENGINE_UID}" mysql \
 && adduser -S -D -H -h /var/lib/mysql -s /sbin/nologin -u "${ENGINE_UID}" -G mysql mysql \
 && addgroup -S -g "${UNIT_UID}" logger \
 && adduser -S -D -H -h /apps/logger -s /sbin/nologin -u "${UNIT_UID}" -G logger logger \
 && apk add --no-cache mariadb mariadb-client tini \
 && test "$(id -u mysql):$(id -g mysql)" = "${ENGINE_UID}:${ENGINE_UID}" \
 && test "$(id -u logger):$(id -g logger)" = "${UNIT_UID}:${UNIT_UID}" \
 && printf '[client]\nsocket=/run/logger/mysqld.sock\n' > /etc/my.cnf.d/zz-shaper-unit.cnf \
 && chmod 0644 /etc/my.cnf.d/zz-shaper-unit.cnf

# The application code, owned by root and read-only to the unit account
# (Rule 4: app/). Every package sits beside the others, so `../pkg-*/` resolves.
COPY --from=shaper_base /shaper/packages/pkg-db/ /apps/logger/app/packages/pkg-db/
RUN cd /apps/logger/app/packages/pkg-db && npm ci --omit=dev --ignore-scripts --no-audit --no-fund && npm cache clean --force
COPY --from=shaper_base /shaper/packages/pkg-logger/ /apps/logger/app/packages/pkg-logger/

# The unit's MariaDB lifecycle: the container's administrative path, run as root.
COPY --from=shaper_base /shaper/runtime/unit-mariadb/ /usr/local/lib/shaper/unit-mariadb/
RUN ln -s /usr/local/lib/shaper/unit-mariadb/unit-ready /usr/local/bin/unit-ready \
 && install -d -m 0755 -o root -g root /apps/logger/etc /apps/logger/etc/mysql /apps/logger/sav \
 && install -d -m 0750 -o root -g logger /apps/logger/etc/mysql/localhost \
 && install -d -m 0750 -o logger -g logger /apps/logger/log /apps/logger/nosav

ENV NODE_ENV=production \
    SHAPER_UNIT_SLUG=logger \
    SHAPER_DB_SOCKET=/run/logger/mysqld.sock \
    UNIT_UID=10620 \
    UNIT_ENGINE_UID=10621 \
    UNIT_SCHEMA_FILE=/apps/logger/app/packages/pkg-logger/sql/schema.sql \
    UNIT_SCHEMA_VERSION=1 \
    LOGGER_PORT=8620 \
    LOGGER_STORE=mariadb

# The image refuses to exist when it would refuse to start.
RUN UNIT_IMPORT_CHECK="/apps/logger/app/packages/pkg-logger/index.js /apps/logger/app/packages/pkg-logger/mariadb-store.js" node /usr/local/lib/shaper/unit-mariadb/image-check.mjs

WORKDIR /apps/logger/app/packages/pkg-logger
EXPOSE 8620
# No USER: the supervisor is root, starts mariadbd as mysql and the application
# as logger (10620); the application itself never runs as root.
ENTRYPOINT ["/sbin/tini", "--", "node", "/usr/local/lib/shaper/unit-mariadb/supervisor.mjs"]
CMD ["node", "server.js"]
