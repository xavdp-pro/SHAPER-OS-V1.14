{
  "brick": "vault",
  "contractVersion": 1,
  "distribution": "base",
  "buildPackages": [
    "pkg-auth",
    "pkg-db",
    "pkg-logger",
    "pkg-vault"
  ],
  "buildRuntime": [
    "unit-mariadb"
  ],
  "runtimeServices": [
    "logger"
  ],
  "unit": {
    "slug": "vault",
    "uid": 10610,
    "engineUid": 10611,
    "database": "mariadb-in-unit",
    "schema": "/apps/vault/app/packages/pkg-vault/sql/schema.sql",
    "schemaVersion": 3,
    "volumes": [
      "etc/mysql",
      "sav",
      "log"
    ]
  },
  "proof": [
    "vault health",
    "MariaDB inside the unit container: two processes, socket only, one name",
    "encrypted persistence",
    "key continuity",
    "restore decrypts"
  ]
}
