ARG SHAPER_BASE_IMAGE
FROM ${SHAPER_BASE_IMAGE} AS shaper_base
FROM docker.io/library/node:20-alpine

ARG SHAPER_SOURCE_REVISION
LABEL org.opencontainers.image.revision="${SHAPER_SOURCE_REVISION}"
LABEL org.shaper.brick="vault"
LABEL org.shaper.build-packages="logger vault"

WORKDIR /app
COPY --from=shaper_base /shaper/packages/pkg-logger/ /pkg-logger/
COPY --from=shaper_base /shaper/packages/pkg-vault/ ./

EXPOSE 8610
ENV NODE_ENV=production
ENV VAULT_PORT=8610
ENV VAULT_STORAGE_FILE=/data/vault/vault.enc

CMD ["node", "server.js"]
