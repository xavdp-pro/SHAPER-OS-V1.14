{
  "$schema": "./topology.schema.json",
  "version": "1.2.0",
  "description": "SHAPER OS dependency graph & boot order — see overridePolicy",

  "overridePolicy": {
    "rule": "Silence is the default. Nothing is declared here beyond the graph unless a human explicitly requests an override. All unspecified details are left to the agent, provided they respect each brick INTENT invariants.",
    "overrideWhen": "A human states a specific constraint (port, path, credential, schema, extra dependency). Then add it to topology.json or a local deps.json — never preemptively."
  },

  "materializationPipeline": [
    "intent",
    "materialize",
    "test",
    "registry",
    "deploy"
  ],
  "artifactBoundary": "./artifact-boundary.json",

  "minimalSocle": {
    "packages": [
      "@shaper/vault",
      "@shaper/logger",
      "@shaper/queue",
      "@shaper/maestro",
      "@shaper/agent",
      "@shaper/auth",
      "@shaper/bridge-agy",
      "@shaper/bridge-cursor",
      "@shaper/bridge-deepseek",
      "@shaper/bridge-opencode",
      "opencode-bridge",
      "@shaper/supervisor"
    ]
  },

  "bootLayers": [
    ["vault", "logger"],
    ["queue"],
    ["maestro"]
  ],

  "nodes": {
    "vault": {
      "requires": [],
      "optional": [],
      "provides": ["secrets"]
    },
    "logger": {
      "requires": [],
      "optional": [],
      "provides": ["audit-log"]
    },
    "queue": {
      "requires": [],
      "optional": ["logger"],
      "provides": ["job-queue"]
    },
    "maestro": {
      "requires": ["logger"],
      "optional": ["vault", "queue"],
      "provides": ["beat-scheduler"]
    },
    "bridge-agy": {
      "requires": ["vault", "logger"],
      "optional": ["maestro"],
      "provides": ["ai-agent-bridge"]
    },
    "bridge-opencode": {
      "requires": ["logger"],
      "optional": ["maestro"],
      "provides": ["ai-agent-bridge-free"]
    },
    "auth": {
      "requires": [],
      "optional": [],
      "provides": ["bearer-auth"]
    },
    "agent": {
      "requires": ["auth"],
      "optional": ["vault", "logger"],
      "provides": ["agent-task-registry"]
    },
    "qdrant": {
      "requires": [],
      "optional": [],
      "provides": ["vector-database"],
      "optionalBrick": true
    }
  },

  "packageImports": {
    "@shaper/maestro": ["@shaper/logger", "@shaper/agent", "@shaper/vault"],
    "@shaper/agent": ["@shaper/auth"],
    "@shaper/vault": [],
    "@shaper/queue": [],
    "@shaper/logger": [],
    "@shaper/auth": [],
    "@shaper/db": []
  }
}
